{
  "name": "Browser Companion Extensions",
  "description": "Very Fun Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "host_permissions": ["https://dummyjson.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "companion-view.js",
        "cursor-companion.js",
        "companion-chat.js",
        "corner-companion.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.png", "companion.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
